{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonabi.dev/schema/moonabi-report.schema.json",
  "title": "MoonABI Check Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract",
    "status",
    "diagnostics"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "contract": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "$defs": {
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "subject",
        "message",
        "expected",
        "actual"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^ABI[0-9]{4}$"
        },
        "severity": {
          "enum": [
            "warning",
            "error"
          ]
        },
        "subject": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "expected": {
          "type": "string"
        },
        "actual": {
          "type": "string"
        }
      }
    }
  }
}

